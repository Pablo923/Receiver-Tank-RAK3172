{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "IDF: Build",
            "type": "shell",
            "command": "make",
            "args": ["build"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "IDF: Flash",
            "type": "shell",
            "command": "make",
            "args": ["flash", "PORT=${config:idf.port}"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "IDF: Flash + Monitor",
            "type": "shell",
            "command": "make",
            "args": ["flash-monitor", "PORT=${config:idf.port}"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "IDF: Monitor",
            "type": "shell",
            "command": "make",
            "args": ["monitor", "PORT=${config:idf.port}"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "IDF: Clean",
            "type": "shell",
            "command": "make",
            "args": ["clean"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "IDF: Set Target",
            "type": "shell",
            "command": "make",
            "args": ["set-target", "IDF_TARGET=${input:target}"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "target",
            "type": "pickString",
            "description": "Selecciona el target",
            "options": ["esp32c6", "esp32h2", "esp32", "esp32s3", "esp32s2", "esp32c3"]
        }
    ]
}
